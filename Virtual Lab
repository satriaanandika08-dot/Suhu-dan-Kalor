    <section id="recordsView" class="view hidden">
      <div class="page-heading"><button class="btn btn-light back-btn" onclick="showView('menuView')">← Kembali</button><div><h2>Rekap Nilai Siswa</h2><div style="color:var(--muted);font-size:13px">Daftar hasil yang tersimpan pada browser/perangkat ini.</div></div></div>
      <div class="panel"><div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:13px"><div><h3 style="margin:0">Data Penilaian</h3><p style="font-size:12px;margin:3px 0 0">Data lokal tidak otomatis terkirim ke perangkat lain.</p></div><div style="display:flex;gap:8px;flex-wrap:wrap"><button class="btn btn-light btn-small" onclick="exportRecordsCSV()">⬇ Ekspor CSV</button><button class="btn btn-danger btn-small" onclick="clearRecords()">Hapus semua</button></div></div><div id="recordsMount"></div></div>
    </section>
    <div class="footer">Virtual Lab Suhu & Kalor · Media pembelajaran interaktif fisika</div>
  </main>
</div>
<div id="toast" class="toast" role="status" aria-live="polite"></div>

<script>
'use strict';
const $ = (id) => document.getElementById(id);
let currentStudent = {name:'', kelas:''};
let volatileResults = [];
let activeQuestions = [], quizAnswers = {}, questionIndex = 0, quizSeconds = 600, quizTimer = null, lastResult = null;
let transferType = 'konduksi', transferTimer = null, heatTimer = null, phaseTimer = null;
const VIEWS = ['menuView','materialMenuView','topicView','quizSetupView','quizView','resultView','recordsView'];

function showView(id){VIEWS.forEach(v=>$(v).classList.toggle('hidden',v!==id));window.scrollTo({top:0,behavior:'smooth'});}
function toast(message){const t=$('toast');t.textContent=message;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2400)}
function saveStudent(){ $('topStudent').textContent=currentStudent.name; $('topClass').textContent='· '+currentStudent.kelas; $('welcomeName').textContent=currentStudent.name.split(' ')[0]; }
$('loginForm').addEventListener('submit',e=>{e.preventDefault();const name=$('loginName').value.trim(),kelas=$('loginClass').value.trim(),password=$('loginPassword').value;if(!name||!kelas){toast('Nama dan kelas harus diisi.');return;}if(password!=='12345'){toast('Password belum tepat. Coba password demo 12345.');return;}currentStudent={name,kelas};saveStudent();$('quizName').value=name;$('quizClass').value=kelas;$('loginPassword').value='';$('loginScreen').classList.add('hidden');$('appShell').classList.remove('hidden');showView('menuView');});
$('logoutBtn').addEventListener('click',()=>{if(quizTimer){clearInterval(quizTimer);quizTimer=null;}currentStudent={name:'',kelas:''};$('appShell').classList.add('hidden');$('loginScreen').classList.remove('hidden');$('loginName').value='';$('loginClass').value='';$('loginPassword').value='';});
function openTopic(topic){document.querySelectorAll('.topic-content').forEach(el=>el.classList.add('hidden'));$('topic-'+topic).classList.remove('hidden');const names={suhu:'A. Suhu',kalor:'B. Kalor',wujud:'C. Perubahan Wujud Benda',pindah:'D. Perpindahan Kalor'};$('topicHeading').textContent=names[topic];showView('topicView');if(topic==='suhu')updateThermometer();if(topic==='kalor'){updateHeatCalc();drawHeatChart(false);}if(topic==='wujud')updatePhaseLab();if(topic==='pindah')resetTransfer();}

// A. Termometer dan konversi suhu
function fmt(n,d=1){return Number(n).toLocaleString('id-ID',{minimumFractionDigits:d,maximumFractionDigits:d});}
function updateThermometer(){const c=Number($('tempSlider').value);$('tempOutput').textContent=c+'°C';$('mercury').style.height=(8+c*.78)+'%';$('waterFill').style.height=(35+c*.45)+'%';$('outC').textContent=fmt(c,1)+' °C';$('outR').textContent=fmt(c*4/5,1)+' °R';$('outF').textContent=fmt(c*9/5+32,1)+' °F';$('outK').textContent=fmt(c+273.15,2)+' K';$('convertValue').value=c;}
function toCelsius(value,scale){if(scale==='C')return value;if(scale==='R')return value*5/4;if(scale==='F')return (value-32)*5/9;if(scale==='K')return value-273.15;return value;}
function fromCelsius(c,scale){if(scale==='C')return c;if(scale==='R')return c*4/5;if(scale==='F')return c*9/5+32;if(scale==='K')return c+273.15;return c;}
function convertTemperature(){const value=Number($('convertValue').value),[from,to]=$('convertFrom').value.split('-');if(!Number.isFinite(value)){toast('Masukkan angka suhu yang valid.');return;}const result=fromCelsius(toCelsius(value,from),to);const symbols={C:'°C',R:'°R',F:'°F',K:'K'};$('convertResult').textContent=`${fmt(value,2)} ${symbols[from]} = ${fmt(result,2)} ${symbols[to]}`;}
function startTempLab(){const c=Number($('tempSlider').value);$('tempConclusion').textContent=`Pada suhu ${c}°C, termometer menunjukkan nilai yang lebih tinggi dibandingkan saat suhu rendah. Nilai suhu yang sama dapat dinyatakan dalam skala berbeda: ${fmt(c*4/5,1)}°R, ${fmt(c*9/5+32,1)}°F, dan ${fmt(c+273.15,2)} K.`;$('tempConclusion').classList.add('show');}
function resetTempLab(){$('tempSlider').value=25;updateThermometer();$('tempConclusion').classList.remove('show');$('convertResult').textContent='Hasil konversi akan muncul di sini.';}

// B. Pemanasan air
function heatValues(){const mass=Number($('massSlider').value),c=Number($('specificSlider').value),t1=Number($('initialTemp').value),t2=Number($('finalTemp').value),delta=Math.max(0,t2-t1);return {mass,c,t1,t2,delta,Q:mass/1000*c*delta};}
function updateHeatCalc(){const v=heatValues();$('massOutput').textContent=v.mass+' g';$('specificOutput').textContent=v.c.toLocaleString('id-ID')+' J/kg°C';$('initialOutput').textContent=v.t1+'°C';$('finalOutput').textContent=v.t2+'°C';$('deltaReadout').textContent=v.delta+'°C';$('heatReadout').textContent=Math.round(v.Q).toLocaleString('id-ID')+' J';$('heatConclusion').classList.remove('show');drawHeatChart(false);}
function drawHeatChart(animated){const canvas=$('heatChart');if(!canvas)return;const ctx=canvas.getContext('2d'),w=canvas.width,h=canvas.height;ctx.clearRect(0,0,w,h);const p={l:48,r:16,t:12,b:30};ctx.strokeStyle='#dce7f0';ctx.lineWidth=1;for(let i=0;i<=4;i++){let y=p.t+(h-p.t-p.b)*i/4;ctx.beginPath();ctx.moveTo(p.l,y);ctx.lineTo(w-p.r,y);ctx.stroke();ctx.fillStyle='#71869a';ctx.font='12px Arial';ctx.fillText(String(100-i*25),8,y+4);}ctx.beginPath();ctx.moveTo(p.l,p.t);ctx.lineTo(p.l,h-p.b);ctx.lineTo(w-p.r,h-p.b);ctx.strokeStyle='#8198ad';ctx.stroke();ctx.fillStyle='#55718b';ctx.font='12px Arial';ctx.fillText('Suhu (°C)',p.l,10);ctx.fillText('Waktu pemanasan →',w-155,h-7);const v=heatValues();const y1=h-p.b-(v.t1/100)*(h-p.t-p.b),y2=h-p.b-(v.t2/100)*(h-p.t-p.b),xEnd=w-p.r;ctx.beginPath();ctx.moveTo(p.l,y1);ctx.lineTo(animated?xEnd:p.l+((xEnd-p.l)*.7),animated?y2:y1);if(animated)ctx.lineTo(xEnd,y2);ctx.strokeStyle='#f28b39';ctx.lineWidth=4;ctx.lineJoin='round';ctx.stroke();ctx.fillStyle='#1769aa';ctx.beginPath();ctx.arc(p.l,y1,5,0,Math.PI*2);ctx.fill();if(animated){ctx.fillStyle='#f28b39';ctx.beginPath();ctx.arc(xEnd,y2,5,0,Math.PI*2);ctx.fill();}}
function heatWater(){if(heatTimer)clearTimeout(heatTimer);const v=heatValues();if(v.t2<=v.t1){toast('Suhu akhir harus lebih tinggi dari suhu awal.');return;}const stage=$('heaterStage');stage.classList.add('heat-on');$('heatConclusion').classList.remove('show');$('heatConclusion').textContent=`Air menerima kalor sebesar Q = m × c × ΔT = ${v.mass/1000} × ${v.c} × ${v.delta} = ${Math.round(v.Q).toLocaleString('id-ID')} J. Kenaikan suhu terjadi karena energi berpindah ke air.`;drawHeatChart(true);heatTimer=setTimeout(()=>{stage.classList.remove('heat-on');$('heatConclusion').classList.add('show');},3200);}
function resetHeatLab(){if(heatTimer)clearTimeout(heatTimer);$('heaterStage').classList.remove('heat-on');$('massSlider').value=500;$('specificSlider').value=4200;$('initialTemp').value=25;$('finalTemp').value=80;updateHeatCalc();$('heatConclusion').classList.remove('show');}

// C. Perubahan wujud dengan kurva pemanasan
const phaseSegments=[2100,33400,42000,226000,4000];const phaseEnds=phaseSegments.reduce((a,b)=>{a.push((a[a.length-1]||0)+b);return a;},[]);const totalPhaseHeat=phaseEnds[phaseEnds.length-1];
function phaseAt(q){const m=.1;if(q<=phaseEnds[0])return {temp:-10+10*q/phaseSegments[0],label:'Es dipanaskan: suhu naik',emoji:'🧊',latent:'Belum terjadi perubahan wujud.'};if(q<=phaseEnds[1])return {temp:0,label:'Es melebur menjadi air: suhu tetap',emoji:'🧊💧',latent:`Q lebur = m × Lf = 0,1 kg × 334.000 J/kg = 33.400 J.`};if(q<=phaseEnds[2])return {temp:100*(q-phaseEnds[1])/phaseSegments[2],label:'Air dipanaskan: suhu naik',emoji:'💧',latent:'Air masih berwujud cair dan suhunya meningkat.'};if(q<=phaseEnds[3])return {temp:100,label:'Air mendidih/menguap: suhu tetap',emoji:'💧♨️',latent:`Q uap = m × Lv = 0,1 kg × 2.260.000 J/kg = 226.000 J.`};return {temp:100+20*(q-phaseEnds[3])/phaseSegments[4],label:'Uap air dipanaskan',emoji:'♨️',latent:'Air telah berubah menjadi uap; suhu uap meningkat.'};}
function updatePhaseLab(){const pct=Number($('phaseSlider').value),q=totalPhaseHeat*pct/100,s=phaseAt(q),temp=fmt(s.temp,1);$('phaseOutput').textContent=pct+'%';$('phaseTemp').textContent=temp+'°C';$('phaseEnergy').textContent=Math.round(q).toLocaleString('id-ID')+' J';$('phaseLabel').textContent=s.label;$('phaseObject').textContent=s.emoji.includes('🧊')?'🧊':(s.emoji.includes('💧')?'💧':'♨️');$('phaseSteam').classList.toggle('active',s.temp>=100);$('latentCalc').textContent=s.latent;$('phaseConclusion').classList.remove('show');const x=40+460*pct/100;let y;if(s.temp<=0)y=100-(s.temp+10)*.9;else if(s.temp<=100)y=91-s.temp*.61;else y=30-(s.temp-100)*.8;$('phaseDot').setAttribute('cx',x);$('phaseDot').setAttribute('cy',y);}
function startPhaseLab(){const pct=Number($('phaseSlider').value),s=phaseAt(totalPhaseHeat*pct/100);$('phaseConclusion').textContent=`Pada tingkat pemanasan ${pct}%, sistem berada pada tahap: ${s.label.toLowerCase()}. Perhatikan bahwa saat melebur atau menguap, kalor yang diserap menjadi kalor laten sehingga suhu tetap untuk sementara.`;$('phaseConclusion').classList.add('show');}
function resetPhaseLab(){if(phaseTimer)clearInterval(phaseTimer);$('phaseSlider').value=0;updatePhaseLab();$('phaseConclusion').classList.remove('show');}

// D. Tiga mekanisme perpindahan kalor
const transferInfo={
 konduksi:{desc:'Batang logam dipanaskan pada salah satu ujung. Energi merambat melalui logam tanpa perpindahan zat secara keseluruhan.',conclusion:'Panas merambat dari ujung yang lebih panas ke bagian batang yang lebih dingin melalui interaksi antarpartikel. Batang tetap pada tempatnya, sehingga ini merupakan konduksi.',scene:'<div class="rod-fire">🔥</div><div class="metal-rod"></div><div class="heat-dots"><span>♨</span><span>♨</span><span>♨</span></div>'},
 konveksi:{desc:'Air di dalam panci dipanaskan dari bawah. Air yang lebih panas bergerak naik, sedangkan air yang lebih dingin bergerak turun.',conclusion:'Terbentuk arus konveksi karena perbedaan massa jenis air akibat perbedaan suhu. Kalor berpindah bersama gerakan zat cair.',scene:'<div style="font-size:25px;position:absolute;top:16px">🔥</div><div class="convection-pot"><span class="particle"></span><span class="particle p2"></span><span class="particle p3"></span></div>'},
 radiasi:{desc:'Tangan berada di dekat api unggun tanpa menyentuh api. Energi panas sampai ke tangan melalui gelombang elektromagnetik.',conclusion:'Energi dari api sampai ke tangan tanpa harus melalui sentuhan langsung atau aliran zat. Perpindahan ini disebut radiasi dan tidak memerlukan medium.',scene:'<div class="radiation-fire">🔥</div><div class="wave"></div><div class="wave w2"></div><div class="wave w3"></div><div class="hand">🖐️</div>'}
};
function selectTransfer(type){transferType=type;document.querySelectorAll('[data-exp-tab]').forEach(b=>b.classList.toggle('active',b.dataset.expTab===type));resetTransfer();}
function resetTransfer(){if(transferTimer)clearTimeout(transferTimer);$('transferStage').classList.remove('running');$('transferScene').innerHTML=transferInfo[transferType].scene;$('transferDescription').textContent=transferInfo[transferType].desc;$('transferConclusion').classList.remove('show');}
function startTransfer(){if(transferTimer)clearTimeout(transferTimer);$('transferStage').classList.add('running');$('transferConclusion').classList.remove('show');transferTimer=setTimeout(()=>{$('transferStage').classList.remove('running');$('transferConclusion').textContent=transferInfo[transferType].conclusion;$('transferConclusion').classList.add('show');},3300);}

// Kumpulan soal: lima teori dan lima praktik.
const questionBank=[
 {type:'Teori',q:'Alat yang digunakan untuk mengukur suhu suatu benda adalah ....',opts:['Barometer','Termometer','Dinamometer','Amperemeter'],a:1,ex:'Termometer digunakan untuk mengukur suhu. Barometer mengukur tekanan udara, dinamometer mengukur gaya, dan amperemeter mengukur arus listrik.'},
 {type:'Praktik',q:'Termometer menunjukkan suhu air 40°C. Berapakah suhu tersebut dalam skala Fahrenheit?',visual:'<div style="display:inline-flex;align-items:center;gap:15px"><span style="font-size:40px">🌡️</span><span style="font-size:23px;color:#1769aa">40°C</span></div><div style="font-size:12px;font-weight:500">Baca nilai pada termometer, lalu konversikan.</div>',opts:['72°F','96°F','104°F','120°F'],a:2,ex:'Gunakan °F = (9/5 × °C) + 32. Jadi °F = (9/5 × 40) + 32 = 72 + 32 = 104°F.'},
 {type:'Teori',q:'Persamaan yang tepat untuk menghitung kalor yang menyebabkan perubahan suhu adalah ....',opts:['Q = m × c × ΔT','Q = m ÷ c × ΔT','Q = c ÷ (m × ΔT)','Q = m × ΔT ÷ c'],a:0,ex:'Kalor untuk perubahan suhu dihitung menggunakan Q = m × c × ΔT, dengan massa, kalor jenis, dan perubahan suhu.'},
 {type:'Praktik',q:'Air bermassa 0,2 kg dipanaskan dari 25°C menjadi 35°C. Jika kalor jenis air 4.200 J/kg°C, kalor yang diserap adalah ....',visual:'<div style="font-size:13px;line-height:1.8">Massa = 0,2 kg<br>Suhu awal = 25°C · Suhu akhir = 35°C<br>Kalor jenis = 4.200 J/kg°C</div>',opts:['4.200 J','8.400 J','16.800 J','42.000 J'],a:1,ex:'ΔT = 35 − 25 = 10°C. Q = m × c × ΔT = 0,2 × 4.200 × 10 = 8.400 J.'},
 {type:'Teori',q:'Perpindahan kalor yang terjadi melalui zat padat tanpa perpindahan zat secara keseluruhan disebut ....',opts:['Konveksi','Radiasi','Konduksi','Evaporasi'],a:2,ex:'Konduksi adalah perpindahan kalor melalui suatu bahan tanpa perpindahan partikel zat secara keseluruhan. Logam merupakan penghantar kalor yang baik.'},
 {type:'Praktik',q:'Sebanyak 0,1 kg es melebur seluruhnya pada titik leburnya. Jika kalor lebur es 334.000 J/kg, kalor yang diperlukan adalah ....',visual:'<div style="font-size:34px">🧊 → 💧</div><div style="font-size:12px;font-weight:500">m = 0,1 kg · L = 334.000 J/kg</div>',opts:['3.340 J','16.700 J','33.400 J','334.000 J'],a:2,ex:'Kalor laten dihitung dengan Q = m × L. Q = 0,1 × 334.000 = 33.400 J.'},
 {type:'Teori',q:'Ketika es sedang melebur pada tekanan tetap, suhu es-air cenderung ....',opts:['Terus meningkat','Tetap selama proses melebur','Langsung menjadi 100°C','Selalu turun'],a:1,ex:'Pada zat murni dan tekanan tetap, suhu tetap selama perubahan wujud. Kalor yang diserap digunakan sebagai kalor laten untuk mengubah fase.'},
 {type:'Praktik',q:'Suhu air 27°C pada termometer Celsius. Jika dikonversi ke Kelvin dengan pendekatan K = °C + 273,15, hasilnya adalah ....',visual:'<div style="font-size:14px">Pembacaan termometer: <strong style="color:#1769aa">27°C</strong></div>',opts:['246,15 K','273,15 K','300,15 K','310,15 K'],a:2,ex:'K = °C + 273,15 = 27 + 273,15 = 300,15 K.'},
 {type:'Teori',q:'Panas Matahari dapat sampai ke Bumi terutama melalui proses ....',opts:['Konduksi','Konveksi','Radiasi','Konduksi dan konveksi saja'],a:2,ex:'Ruang antara Matahari dan Bumi hampir hampa. Radiasi dapat merambat tanpa medium, sehingga menjadi mekanisme utama perpindahan energi Matahari ke Bumi.'},
 {type:'Praktik',q:'Sebuah benda bermassa 0,5 kg dengan kalor jenis 800 J/kg°C mengalami kenaikan suhu 5°C. Kalor yang diterima benda adalah ....',visual:'<div style="font-size:13px;line-height:1.8">m = 0,5 kg<br>c = 800 J/kg°C<br>ΔT = 5°C</div>',opts:['400 J','1.000 J','2.000 J','4.000 J'],a:2,ex:'Q = m × c × ΔT = 0,5 × 800 × 5 = 2.000 J.'}
];
function startQuiz(){const name=$('quizName').value.trim(),kelas=$('quizClass').value.trim(),count=Number($('questionCount').value);if(!name||!kelas){toast('Lengkapi nama dan kelas terlebih dahulu.');return;}currentStudent={name,kelas};saveStudent();activeQuestions=questionBank.slice(0,count);quizAnswers={};questionIndex=0;quizSeconds=600;$('quizIdentity').textContent=name+' · '+kelas+' · '+count+' soal';showView('quizView');renderQuestion();startQuizTimer();}
$('quizSetupForm').addEventListener('submit',e=>{e.preventDefault();startQuiz();});
function startQuizTimer(){if(quizTimer)clearInterval(quizTimer);updateTimer();quizTimer=setInterval(()=>{quizSeconds--;updateTimer();if(quizSeconds<=0){clearInterval(quizTimer);quizTimer=null;finishQuiz(true);}},1000);}
function updateTimer(){const m=Math.floor(Math.max(0,quizSeconds)/60),s=Math.max(0,quizSeconds)%60;$('timerText').textContent=String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');$('timerBox').classList.toggle('warning',quizSeconds<=120);}
function renderQuestion(){const q=activeQuestions[questionIndex],chosen=quizAnswers[questionIndex];$('quizProgress').style.width=((questionIndex+1)/activeQuestions.length*100)+'%';let html=`<div class="question-card"><div class="question-meta"><span>SOAL ${questionIndex+1} DARI ${activeQuestions.length}</span><span class="type-pill">${q.type}</span></div><h3>${q.q}</h3>`;if(q.visual)html+=`<div class="question-visual">${q.visual}</div>`;html+='<div class="options">';q.opts.forEach((op,i)=>{html+=`<label class="option ${chosen===i?'selected':''}"><input type="radio" name="answer" value="${i}" ${chosen===i?'checked':''} onchange="chooseAnswer(${i})"><span><strong>${String.fromCharCode(65+i)}.</strong> ${op}</span></label>`;});html+='</div><div class="quiz-actions">';html+=`<button class="btn btn-light" ${questionIndex===0?'disabled':''} onclick="moveQuestion(-1)">← Sebelumnya</button>`;if(questionIndex<activeQuestions.length-1)html+='<button class="btn btn-primary" onclick="moveQuestion(1)">Berikutnya →</button>';else html+='<button class="btn btn-orange" onclick="confirmFinishQuiz()">Selesaikan Latihan</button>';html+='</div></div>';$('questionMount').innerHTML=html;renderQuestionNumbers();}
function chooseAnswer(i){quizAnswers[questionIndex]=i;renderQuestionNumbers();document.querySelectorAll('.option').forEach((el,idx)=>el.classList.toggle('selected',idx===i));}
function moveQuestion(delta){questionIndex=Math.max(0,Math.min(activeQuestions.length-1,questionIndex+delta));renderQuestion();}
function jumpQuestion(i){questionIndex=i;renderQuestion();}
function renderQuestionNumbers(){$('questionNumbers').innerHTML=activeQuestions.map((q,i)=>`<button class="${i===questionIndex?'current ':''}${quizAnswers[i]!==undefined?'answered':''}" onclick="jumpQuestion(${i})">${i+1}</button>`).join('');}
function confirmFinishQuiz(){const unanswered=activeQuestions.length-Object.keys(quizAnswers).length;if(unanswered>0){if(!confirm(`Masih ada ${unanswered} soal yang belum dijawab. Tetap selesaikan latihan?`))return;}finishQuiz(false);}
function categoryFor(score){if(score>=86)return'Sangat Baik';if(score>=76)return'Baik';if(score>=60)return'Cukup';return'Kurang';}
function finishQuiz(auto){if(quizTimer){clearInterval(quizTimer);quizTimer=null;}const total=activeQuestions.length,correct=activeQuestions.reduce((n,q,i)=>n+(quizAnswers[i]===q.a?1:0),0),score=Math.round(correct/total*100);const result={id:Date.now(),name:$('quizName').value.trim(),kelas:$('quizClass').value.trim(),score,category:categoryFor(score),correct,total,date:new Date().toISOString(),timeUp:auto,questions:activeQuestions.map((q,i)=>({q:q.q,type:q.type,opts:q.opts,selected:quizAnswers[i]??null,answer:q.a,ex:q.ex}))};lastResult=result;saveResult(result);renderResult(result);showView('resultView');}
function readStoredResults(){try{return JSON.parse(window.localStorage.getItem('virtualLabResults')||'[]');}catch(e){return volatileResults;}}
function saveResult(result){const list=readStoredResults();list.unshift(result);volatileResults=list;try{window.localStorage.setItem('virtualLabResults',JSON.stringify(list));}catch(e){/* Cadangan sesi digunakan bila penyimpanan lokal dibatasi browser. */}}
function renderResult(r){$('resultName').textContent=r.name;$('resultClass').textContent='Kelas '+r.kelas;$('resultScore').textContent=r.score;$('resultCategory').textContent='Kategori: '+r.category;$('resultSummary').textContent=`${r.correct} dari ${r.total} jawaban benar.${r.timeUp?' Waktu pengerjaan telah habis.':''}`;const date=new Date(r.date).toLocaleDateString('id-ID',{day:'2-digit',month:'long',year:'numeric'});$('reviewList').innerHTML=r.questions.map((q,i)=>{const good=q.selected===q.answer;const picked=q.selected===null?'Tidak dijawab':String.fromCharCode(65+q.selected)+'. '+q.opts[q.selected];const correct=String.fromCharCode(65+q.answer)+'. '+q.opts[q.answer];return `<article class="review-item ${good?'correct':'incorrect'}"><h4>${i+1}. ${q.q}</h4><p><span class="answer-label">Jawabanmu:</span> ${picked}</p><p><span class="answer-label">Jawaban benar:</span> ${correct}</p><p><span class="answer-label">Pembahasan:</span> ${q.ex}</p><p style="font-size:11px;color:#8a9bab">${good?'✓ Benar':'✗ Belum tepat'} · ${q.type}</p></article>`;}).join('');}
function resultMessage(){const r=lastResult;if(!r)return'';return `Hasil Latihan Virtual Lab Suhu dan Kalor\nNama: ${r.name}\nKelas: ${r.kelas}\nNilai: ${r.score}\nKategori: ${r.category}\nTanggal: ${new Date(r.date).toLocaleDateString('id-ID',{day:'2-digit',month:'long',year:'numeric'})}`;}
function sendResultWhatsApp(){if(!lastResult)return;const recipient=prompt('Nomor WhatsApp pengajar (contoh: 628123456789). Kosongkan untuk memilih kontak di WhatsApp:','');const digits=(recipient||'').replace(/\D/g,'');const url=digits?'https://wa.me/'+digits+'?text=':'https://wa.me/?text=';window.open(url+encodeURIComponent(resultMessage()),'_blank','noopener');}
function sendResultEmail(){if(!lastResult)return;const recipient=prompt('Alamat email pengajar (boleh dikosongkan):','')||'';const subject='Hasil Latihan Suhu dan Kalor - '+lastResult.name;window.location.href='mailto:'+encodeURIComponent(recipient)+'?subject='+encodeURIComponent(subject)+'&body='+encodeURIComponent(resultMessage());}
function retryQuiz(){if(quizTimer){clearInterval(quizTimer);quizTimer=null;}$('quizName').value=lastResult?.name||currentStudent.name;$('quizClass').value=lastResult?.kelas||currentStudent.kelas;showView('quizSetupView');}
function openRecords(){renderRecords();showView('recordsView');}
function getRecords(){return readStoredResults();}
function renderRecords(){const list=getRecords();if(!list.length){$('recordsMount').innerHTML='<div class="empty-state">Belum ada hasil latihan yang tersimpan pada browser ini.</div>';return;}$('recordsMount').innerHTML=`<div class="table-wrap"><table class="records-table"><thead><tr><th>No.</th><th>Nama</th><th>Kelas</th><th>Nilai</th><th>Kategori</th><th>Tanggal</th></tr></thead><tbody>${list.map((r,i)=>`<tr><td>${i+1}</td><td>${escapeHtml(r.name)}</td><td>${escapeHtml(r.kelas)}</td><td><strong>${r.score}</strong></td><td>${r.category}</td><td>${new Date(r.date).toLocaleDateString('id-ID')}</td></tr>`).join('')}</tbody></table></div><p style="font-size:11px;color:#8495a5;margin:10px 2px">Total tersimpan: ${list.length} hasil.</p>`;}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function clearRecords(){if(!confirm('Hapus seluruh rekap nilai dari browser ini?'))return;volatileResults=[];try{window.localStorage.removeItem('virtualLabResults');}catch(e){}renderRecords();toast('Rekap nilai telah dihapus.');}
function exportRecordsCSV(){const list=getRecords();if(!list.length){toast('Belum ada data untuk diekspor.');return;}const rows=[['Nama','Kelas','Nilai','Kategori','Jawaban Benar','Jumlah Soal','Tanggal'],...list.map(r=>[r.name,r.kelas,r.score,r.category,r.correct,r.total,new Date(r.date).toLocaleString('id-ID')])];const csv=rows.map(row=>row.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(';')).join('\n');const blob=new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8;'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='rekap-nilai-virtual-lab.csv';a.click();URL.revokeObjectURL(url);}

// Inisialisasi tampilan simulasi
updateThermometer();updateHeatCalc();updatePhaseLab();resetTransfer();
