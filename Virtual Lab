<body>
<section id="loginScreen" class="login-screen">
  <div class="login-card">
    <div class="brand-mark">🌡️</div>
    <h1>Virtual Lab<br><span style="color:var(--orange)">Suhu & Kalor</span></h1>
    <p class="sub">Belajar fisika dengan mencoba, mengamati, dan menyimpulkan.</p>
    <form id="loginForm">
      <div class="field"><label for="loginName">Nama Siswa</label><input id="loginName" autocomplete="name" placeholder="Masukkan nama lengkap" required></div>
      <div class="field"><label for="loginClass">Kelas</label><input id="loginClass" placeholder="Contoh: VII A / XI IPA 1" required></div>
      <div class="field"><label for="loginPassword">Password</label><input id="loginPassword" type="password" placeholder="Masukkan password" required></div>
      <button class="btn btn-primary btn-block" type="submit">Masuk ke Laboratorium <span>→</span></button>
    </form>
    <div class="hint">Password demo: <strong>12345</strong>. Nama dan kelas akan ditampilkan pada halaman belajar.</div>
  </div>
</section>

<div id="appShell" class="app-shell hidden">
